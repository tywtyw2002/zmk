#include <dt-bindings/zmk/matrix_transform.h>
// #include <layouts/common/60percent/ansi.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        // zmk,physical-layout = &layout_60_ansi;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "col2row";
        row-gpios
            =
              <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // row 0
            , <&gpio0 30 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // row 1
            , <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 2
            , <&gpio1 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // row 3
            ;

        col-gpios
            =
              <&gpio1 4 GPIO_ACTIVE_HIGH> // col 0
            , <&gpio1 0 GPIO_ACTIVE_HIGH> // col 1
            , <&gpio0 22 GPIO_ACTIVE_HIGH> // col 2
            , <&gpio0 20 GPIO_ACTIVE_HIGH> // col 3
            , <&gpio1 13 GPIO_ACTIVE_HIGH> // col 4
            , <&gpio0 2 GPIO_ACTIVE_HIGH> // col 5

            , <&gpio0 29 GPIO_ACTIVE_HIGH> // col 6
            , <&gpio0 26 GPIO_ACTIVE_HIGH> // col 7
            , <&gpio0 6 GPIO_ACTIVE_HIGH> // col 8
            , <&gpio0 8 GPIO_ACTIVE_HIGH> // col 9
            , <&gpio0 4 GPIO_ACTIVE_HIGH> // col 10
            , <&gpio0 12 GPIO_ACTIVE_HIGH> // col 11
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <13>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)   RC(0,11)
RC(1,0)  RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)   RC(1,11)
RC(2,0)   RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)   RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3)  RC(3,4)     RC(3,5)     RC(3,7)   RC(3,8)  RC(3,9) RC(3,10) RC(3,11)
        >;
    };
};

