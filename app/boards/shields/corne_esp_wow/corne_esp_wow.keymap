#include <behaviors.dtsi>
#include <dt-bindings/zmk/crepeat.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        ht_space: ht_space {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_SPACE";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
        };

        ht_shift: ht_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_SHIFT";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    macros {
        m_space: m_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 1 &kp SPACE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 1 &kp SPACE>;

            label = "M_SPACE";
        };

        stop_rt: stop_rt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&cpt CPT_STOP &to 0>;
            label = "STOP_RT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp N3   &kp N2  &kp N1  &kp W  &kp E                    &kp R
&kp TAB  &kp Q   &kp A   &kp S  &kp D                    &kp T
&kp TAB  &kp Z   &kp X   &kp F  &kp V                    &kp G
                         &mo 2  &ht_shift LSHIFT LSHIFT  &m_space
            >;
        };

        space_ln {
            bindings = <
&kp RIGHT_BRACKET  &trans  &trans  &trans  &trans  &kp LA(R)
&kp LEFT_BRACKET   &trans  &trans  &trans  &trans  &kp LA(T)
&kp ESCAPE         &kp M   &trans  &trans  &trans  &kp B
                                   &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&kp N6   &kp N5  &kp N4           &trans  &kp Y   &kp U
&trans   &trans  &trans           &trans  &trans  &trans
&kp F12  &trans  &kp PRINTSCREEN  &trans  &trans  &tog 3
                                  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&cpt CRT_SEL 1000 &cpt CRT_SEL 1500 &none  &cpt CRC_INC 10  &cpt CRC_INC 1  &cpt CPT_START
&cpt CRT_INC 100  &cpt CRT_INC 250  &none  &none  &none  &cpt CPT_RST
&cpt CRT_DSC 100  &cpt CRT_DSC 250  &none  &none  &none  &stop_rt
                            &cpt CRC_INC 5  &none  &cpt CPT_STOP
            >;
        };
    };
};
