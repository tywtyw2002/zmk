#include <dt-bindings/zmk/matrix_transform.h>
#include "c25-layouts.dtsi"
// #include <physical_layouts.dtsi>

// #include <layouts/common/60percent/ansi.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&pico_header 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pico_header 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pico_header 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pico_header 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pico_header 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&pico_header 20 GPIO_ACTIVE_HIGH>
            , <&pico_header 19 GPIO_ACTIVE_HIGH>
            , <&pico_header 18 GPIO_ACTIVE_HIGH>
            , <&pico_header 17 GPIO_ACTIVE_HIGH>
            , <&pico_header 16 GPIO_ACTIVE_HIGH>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <5>;
// | MX1  | MX2  | MX3  | MX4  | MX5  | MX6  | MX7  | MX8  | MX9  | MX10 | MX11 | MX12 | MX13 |    MX14     |
// |   MX15   | MX16 | MX17 | MX18 | MX19 | MX20 | MX21 | MX22 | MX23 | MX24 | MX25 | MX26 | MX27 |  MX28   |
// |    MX29    | MX30 | MX31 | MX32 | MX33 | MX34 | MX35 | MX36 | MX37 | MX38 | MX39 | MX40 |     MX41     |
// |     MX42      | MX43 | MX44 | MX45 | MX46 | MX47 | MX48 | MX49 | MX50 | MX51 | MX52 |       MX53       |
// |  MX54  |  MX55  |  MX56  |                  MX57                   |  MX58  |  MX59  |  MX60  |  MX61  |
        map = <
RC(0,0)  RC(0,1) RC(0,2) RC(0,3) RC(0,4)
RC(1,0)  RC(1,1) RC(1,2) RC(1,3) RC(1,4)
RC(2,0)  RC(2,1) RC(2,2) RC(2,3) RC(2,4)
RC(3,0)  RC(3,1) RC(3,2) RC(3,3) RC(3,4)
RC(4,0)  RC(4,1) RC(4,2) RC(4,3) RC(4,4)
        >;
    };
};

&physical_layout0 {
    kscan = <&kscan0>;
    transform = <&default_transform>;
};
